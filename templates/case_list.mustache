{{!
    @template local_integritycase/case_list

    Cases in a course.

    Example context (json):
    {
        "hasrows": true,
        "isstaff": true,
        "rows": [{"url": "#", "student": "Sam Student", "activity": "Essay 1", "stage": "investigating",
                  "outcome": "", "handler": "Tess Teacher", "updated": "4/11/26, 10:00", "hidden": true}]
    }
}}
{{#hasrows}}
<table class="table table-striped generaltable local-integritycase-list">
    <thead>
        <tr>
            {{#isstaff}}<th scope="col">{{#str}}student, local_integritycase{{/str}}</th>{{/isstaff}}
            <th scope="col">{{#str}}activity, local_integritycase{{/str}}</th>
            <th scope="col">{{#str}}stage, local_integritycase{{/str}}</th>
            <th scope="col">{{#str}}outcome, local_integritycase{{/str}}</th>
            {{#isstaff}}<th scope="col">{{#str}}handler, local_integritycase{{/str}}</th>{{/isstaff}}
            <th scope="col">{{#str}}lastmodified{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            {{#isstaff}}<td><a href="{{url}}">{{student}}</a>{{#hidden}} <span class="badge bg-secondary text-dark">{{#str}}hiddenbadge, local_integritycase{{/str}}</span>{{/hidden}}</td>{{/isstaff}}
            <td>{{activity}}</td>
            <td>{{^isstaff}}<a href="{{url}}">{{/isstaff}}{{stage}}{{^isstaff}}</a>{{/isstaff}}</td>
            <td>{{outcome}}</td>
            {{#isstaff}}<td>{{handler}}</td>{{/isstaff}}
            <td>{{updated}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
{{/hasrows}}
{{^hasrows}}
<p>{{#str}}nocases, local_integritycase{{/str}}</p>
{{/hasrows}}
