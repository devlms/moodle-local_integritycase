{{!
    @template local_integritycase/case_view

    One case with its history.

    Example context (json):
    {
        "summary": "<p>Two paragraphs match a 2019 essay.</p>",
        "stage": "awaiting student response",
        "outcome": "",
        "activity": "Essay 1",
        "handler": "Tess Teacher",
        "hiddenfromstudent": false,
        "isstaff": true,
        "hasfiles": true,
        "files": [{"name": "report.pdf", "url": "#"}],
        "history": [{"what": "Case opened", "who": "Tess Teacher", "when": "4/11/26, 10:00", "note": "", "private": true}]
    }
}}
<div class="local-integritycase-case">
    {{#hiddenfromstudent}}
    <div class="alert alert-info">{{#str}}studentcannotsee, local_integritycase{{/str}}</div>
    {{/hiddenfromstudent}}
    <dl class="row">
        <dt class="col-sm-3">{{#str}}stage, local_integritycase{{/str}}</dt>
        <dd class="col-sm-9" data-region="stage">{{stage}}</dd>
        {{#outcome}}
        <dt class="col-sm-3">{{#str}}outcome, local_integritycase{{/str}}</dt>
        <dd class="col-sm-9" data-region="outcome">{{outcome}}</dd>
        {{/outcome}}
        {{#activity}}
        <dt class="col-sm-3">{{#str}}activity, local_integritycase{{/str}}</dt>
        <dd class="col-sm-9">{{activity}}</dd>
        {{/activity}}
        <dt class="col-sm-3">{{#str}}handler, local_integritycase{{/str}}</dt>
        <dd class="col-sm-9">{{handler}}</dd>
        <dt class="col-sm-3">{{#str}}summary, local_integritycase{{/str}}</dt>
        <dd class="col-sm-9">{{{summary}}}</dd>
        {{#hasfiles}}
        <dt class="col-sm-3">{{#str}}evidence, local_integritycase{{/str}}</dt>
        <dd class="col-sm-9"><ul class="list-unstyled mb-0">{{#files}}<li><a href="{{url}}">{{name}}</a></li>{{/files}}</ul></dd>
        {{/hasfiles}}
    </dl>
    <h3 class="h5">{{#str}}history, local_integritycase{{/str}}</h3>
    <ol class="list-unstyled border-start ps-3" data-region="history">
        {{#history}}
        <li class="mb-3">
            <div><strong>{{what}}</strong>{{#private}} <span class="badge bg-secondary text-white">{{#str}}staffonly, local_integritycase{{/str}}</span>{{/private}}</div>
            <div class="text-muted small">{{who}} &middot; {{when}}</div>
            {{#note}}<div class="mt-1">{{{note}}}</div>{{/note}}
        </li>
        {{/history}}
    </ol>
</div>
